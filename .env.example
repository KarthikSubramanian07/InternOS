# -----------------------------------------------------------------------------
# InternOS environment — EXAMPLE ONLY. Copy to `.dev.vars` for local `wrangler dev`
# and set the real values as Cloudflare secrets for production:
#     wrangler secret put NOTION_TOKEN
#     wrangler secret put NOTION_DATABASE_ID
#     ... etc.
#
# NOTHING here is committed with real values. Every user brings their own keys.
# -----------------------------------------------------------------------------

# --- Notion ---
# Internal integration token from https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxx
# The database id InternOS writes jobs into (created by `npm run setup:notion`)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Groq (LLM for drafting; each user supplies their own free key) ---
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxx

# --- Gmail (draft creation only; compose scope, cannot send) ---
GMAIL_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxx
# Obtained by running `npm run auth:gmail` once locally
GMAIL_REFRESH_TOKEN=1//xxxx

# --- Webhook auth ---
# Random string. Must equal the ?token=... in your Notion automation webhook URL.
# Generate with: openssl rand -hex 24
WEBHOOK_SECRET=change-me-to-a-long-random-string
