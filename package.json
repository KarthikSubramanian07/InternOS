{
  "name": "internos",
  "version": "0.1.0",
  "description": "Open-source internship application tracker + AI outreach assistant, running on Cloudflare Workers free tier.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run lint && npm run typecheck && npm run test && wrangler deploy --dry-run --outdir dist",
    "scrape:local": "wrangler dev --test-scheduled",
    "setup:notion": "node scripts/setup-notion.mjs",
    "setup:notion:configure": "node scripts/configure-notion.mjs",
    "setup:profile": "node scripts/upload-profile.mjs",
    "auth:gmail": "node scripts/gmail-oauth.mjs"
  },
  "keywords": [
    "internships",
    "job-tracker",
    "cloudflare-workers",
    "notion",
    "groq",
    "gmail",
    "open-source"
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "undici": ">=7.29.0"
  }
}
